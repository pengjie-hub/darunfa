# =====================================================================
# 运行镜像（不含构建步骤，也不含 jar）—— 给 2核2G 机器用
#
# 为什么 jar 不再打进镜像：
#   原来这里是 `COPY dist/app.jar /app/app.jar`，导致 227MB 的 jar 每次部署
#   都要作为「构建上下文」整包传给 buildkit。2G 内存的机器扛不住这个负担，
#   会直接崩在传输阶段：
#     #6 [internal] load build context
#     #6 ERROR: no active session for ...: context deadline exceeded
#   现在改成由 compose 把宿主机目录挂进来（./dist -> /app/dist:ro）：
#   换 jar 只需要 scp 上传 + 重启容器，完全不触发镜像构建。
#
# 前提：服务器上 deploy/dist/app.jar 必须存在
#       （由 scripts/local-release.sh 产出并上传，compose 负责挂载）
# =====================================================================

FROM eclipse-temurin:17-jre-jammy

RUN groupadd --system app \
 && useradd --system --gid app --home-dir /app app \
 && mkdir -p /app/logs /app/dist \
 && chown -R app:app /app

WORKDIR /app

USER app
EXPOSE 8080

# 2G 机器的安全上限：堆 640M 给应用，其余留给元空间/线程栈/堆外，
# 把 MySQL 控制在 192M，整体才能挤进 2G 而不进 swap 抖动。
ENV TZ=Asia/Shanghai \
    JAVA_OPTS="-Xms128m -Xmx640m -XX:+UseSerialGC -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8"

# jar 来自挂载的 /app/dist/app.jar。
# sh -c 让 $JAVA_OPTS 能展开；exec 让 java 成为 PID 1，能收到 SIGTERM 优雅停机。
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/dist/app.jar"]
