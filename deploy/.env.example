# =====================================================================
# 复制为 deploy/.env 后填写真实值：cp deploy/.env.example deploy/.env
# ！！！deploy/.env 绝对不能提交到 Git（已在 .gitignore 中忽略）！！！
# =====================================================================

# --- MySQL root 密码：建议纯字母数字，避免特殊字符在 shell/健康检查里转义踩坑 ---
MYSQL_ROOT_PASSWORD=ChangeMe_MysqlRoot_2026

# --- JWT 签名密钥：至少 32 字符随机串 ---
# 生成命令：openssl rand -base64 48
JWT_SECRET=ChangeMe_Please_Replace_With_48_Random_Chars

# --- 后台管理员初始密码（仅首次启动建号时生效；已有账号不会覆盖）---
ADMIN_PASSWORD=ChangeMe_Admin_2026

# --- DeepSeek：务必去 https://platform.deepseek.com 吊销旧 key 后重新生成 ---
DEEPSEEK_API_KEY=sk-请替换为你新申请的key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
