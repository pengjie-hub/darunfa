# =====================================================================
# 换行符规则
#
# 背景：Windows 默认 core.autocrlf=true，检出时会把 LF 改成 CRLF。
# 而 deploy/ 下的 .sh 是要在 Linux 服务器上执行的 —— 带 CRLF 的脚本
# 会报 `/usr/bin/env: 'bash\r': No such file or directory` 或 `bad interpreter`，
# 排查起来极其费时（文件看着完全正常）。
#
# 所以凡是「在 Linux 上执行或解析」的文件，都显式钉成 LF，不依赖本地配置。
# =====================================================================

# 所有 shell 脚本（含 backend/mvnw、MyApplication5/gradlew）
*.sh    text eol=lf

# 部署目录整体保持 LF（Dockerfile、compose、nginx conf、脚本）
deploy/**  text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf

# 数据库脚本与 nginx 配置
*.sql   text eol=lf
*.conf  text eol=lf

# Windows 批处理必须是 CRLF
*.cmd   text eol=crlf
*.bat   text eol=crlf
