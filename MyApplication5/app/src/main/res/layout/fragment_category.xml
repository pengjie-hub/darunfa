<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.CategoryFragment"
    android:id="@+id/fragment_category"
    android:background="@color/rt_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_12">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_top_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:scrollbars="none"
            android:padding="@dimen/space_10"
            android:background="@drawable/bg_section_card"
            android:elevation="@dimen/elevation_sm"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_12">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_left_category"
                android:layout_width="@dimen/size_100"
                android:layout_height="match_parent"
                android:background="@drawable/bg_section_card"
                android:elevation="@dimen/elevation_sm" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_right_category"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_12"
                android:background="@drawable/bg_section_card"
                android:elevation="@dimen/elevation_sm" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
