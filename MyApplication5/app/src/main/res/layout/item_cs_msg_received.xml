<?xml version="1.0" encoding="utf-8"?>
<!--
  客服消息 - 左侧（AI 智能客服 / 人工客服）
  用 tv_cs_sender 显示发送者，tv_cs_agent_tag 只在「人工客服」时显示。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_12"
    android:paddingTop="@dimen/space_6"
    android:paddingEnd="@dimen/size_touch"
    android:paddingBottom="@dimen/space_6">

    <TextView
        android:id="@+id/tv_cs_avatar"
        android:layout_width="@dimen/size_btn_sm"
        android:layout_height="@dimen/size_btn_sm"
        android:background="@drawable/bg_chat_bubble_ai"
        android:gravity="center"
        android:text="客"
        android:textColor="@color/chat_text_ai_muted"
        android:textSize="@dimen/text_label"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="@dimen/space_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cs_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 客服"
                android:textColor="@color/rt_text_tertiary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/tv_cs_agent_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_6"
                android:background="@color/rt_tag_merchant_surface"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="@dimen/space_1"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_1"
                android:text="人工"
                android:textColor="@color/rt_tag_merchant"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_cs_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_chat_bubble_ai"
            android:lineSpacingExtra="@dimen/space_2"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_8"
            android:textColor="@color/chat_text_ai"
            android:textSize="@dimen/text_body"
            android:text="您好，我是大润发智能客服，请问有什么可以帮您？" />
    </LinearLayout>
</LinearLayout>
