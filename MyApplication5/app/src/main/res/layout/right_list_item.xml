<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:foreground="?attr/selectableItemBackground" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_10"
    android:orientation="horizontal"
    >

    <ImageView
        android:id="@+id/category_pic"
        android:layout_width="@dimen/size_120"
        android:layout_height="@dimen/size_90"
        android:src="@drawable/apple"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_90"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginLeft="@dimen/space_10"
        >

        <TextView
            android:id="@+id/category_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="bao"
            android:textSize="@dimen/text_body"
            android:padding="@dimen/space_4"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_4">  <!-- 垂直居中对齐子控件 -->

            <!-- 商品价格文本（原tv_price） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="价格："
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/category_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_4"
                    android:textColor="@color/rt_accent"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold"/>
            </LinearLayout>

            <Space
                android:layout_width="@dimen/space_0"
                android:layout_height="@dimen/space_1"
                android:layout_weight="1"/>

            <!-- 购物车按钮（现在会被Space挤到最右侧） -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/category_btn_add_to_cart"
                android:layout_width="@dimen/space_20"
                android:layout_height="@dimen/space_20"
                android:layout_marginEnd="@dimen/space_4"
                android:background="@drawable/gouwucheanniu"
                android:backgroundTint="@null"
                android:tintMode="src_atop"
                android:contentDescription="购物车"/>
        </LinearLayout>

        <TextView
            android:id="@+id/category_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_4"
            android:background="@drawable/item_goods_bg"
            android:paddingLeft="@dimen/space_4"
            android:paddingRight="@dimen/space_4"
            android:text="时令"
            android:textColor="@color/rt_text_on_primary"
            android:textSize="@dimen/text_body"/>

    </LinearLayout>

</LinearLayout>