<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rt_background">

    <!-- 顶部搜索栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/rt_primary"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_12">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/space_28"
            android:layout_height="@dimen/space_28"
            android:src="@drawable/ic_circle_arrow_back"
            android:tint="@color/rt_text_on_primary"
            android:contentDescription="返回" />

        <SearchView
            android:id="@+id/search_view"
            android:layout_width="@dimen/space_0"
            android:layout_height="@dimen/space_40"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_10"
            android:background="@drawable/bg_search"
            android:iconifiedByDefault="false"
            android:queryHint="搜索商品..."
            android:queryBackground="@android:color/transparent"
            android:searchIcon="@drawable/ic_search" />

        <TextView
            android:id="@+id/tv_search_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:text="搜索"
            android:textColor="@color/rt_text_on_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 发现面板：搜索历史 + 热门搜索 -->
    <ScrollView
        android:id="@+id/sv_discover"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_12">

            <!-- 搜索历史 -->
            <LinearLayout
                android:id="@+id/ll_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section_card"
                android:padding="@dimen/space_14"
                android:elevation="@dimen/elevation_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="@dimen/space_8">

                    <TextView
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="搜索历史"
                        android:textColor="@color/rt_text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_clear_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/space_8"
                        android:paddingEnd="@dimen/space_4"
                        android:text="清空"
                        android:textColor="@color/rt_text_secondary"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tv_history_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16"
                    android:text="暂无搜索历史"
                    android:textColor="@color/rt_text_hint"
                    android:textSize="@dimen/text_label"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 热门搜索 -->
            <LinearLayout
                android:id="@+id/ll_hot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_section_card"
                android:padding="@dimen/space_14"
                android:elevation="@dimen/elevation_sm">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/space_8"
                    android:text="热门搜索"
                    android:textColor="@color/rt_text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_hot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 结果数量提示 -->
    <TextView
        android:id="@+id/tv_result_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingBottom="@dimen/space_4"
        android:text=""
        android:textColor="@color/rt_text_secondary"
        android:textSize="@dimen/text_label"
        android:visibility="gone" />

    <!-- 搜索结果列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_result"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/space_8"
        android:visibility="gone" />

    <!-- 空状态 -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        android:layout_weight="1"
        android:gravity="center"
        android:text="输入关键词搜索商品"
        android:textColor="@color/rt_text_hint"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />
</LinearLayout>
