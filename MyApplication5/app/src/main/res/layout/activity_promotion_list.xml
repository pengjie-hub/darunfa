<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rt_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/rt_primary"
        app:navigationIcon="@drawable/baseline_arrow_back_24"
        app:title="促销活动"
        app:titleTextColor="@color/rt_text_on_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_0"
        android:layout_weight="1">

        <!-- 促销列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_promotions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingTop="@dimen/space_12"
            android:paddingBottom="@dimen/space_16"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <!-- 加载中 -->
        <LinearLayout
            android:id="@+id/state_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="@dimen/size_btn_lg"
                android:layout_height="@dimen/size_btn_lg"
                android:indeterminateTint="@color/rt_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="正在加载促销活动..."
                android:textColor="@color/rt_text_hint"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- 空状态 -->
        <LinearLayout
            android:id="@+id/state_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_32"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/size_84"
                android:layout_height="@dimen/size_84"
                android:alpha="0.28"
                android:src="@drawable/ic_promotion"
                android:contentDescription="暂无促销" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:text="暂无进行中的促销活动"
                android:textColor="@color/rt_text_primary"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="新的优惠正在筹备中，先去逛逛商品吧"
                android:textColor="@color/rt_text_hint"
                android:textSize="@dimen/text_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_empty_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="去逛逛"
                android:textSize="@dimen/text_body"
                app:cornerRadius="@dimen/radius_md"
                app:backgroundTint="@color/rt_primary" />
        </LinearLayout>

        <!-- 加载失败 -->
        <LinearLayout
            android:id="@+id/state_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_32"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/size_84"
                android:layout_height="@dimen/size_84"
                android:src="@drawable/ic_error_outline"
                android:contentDescription="加载失败" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:text="促销活动加载失败"
                android:textColor="@color/rt_text_primary"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_error_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="请检查网络或后端服务后重试"
                android:textColor="@color/rt_text_hint"
                android:textSize="@dimen/text_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="重 试"
                android:textSize="@dimen/text_body"
                app:cornerRadius="@dimen/radius_md"
                app:backgroundTint="@color/rt_primary" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
