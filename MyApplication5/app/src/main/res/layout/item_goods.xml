<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:foreground="?attr/selectableItemBackground"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_8"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/elevation_md"
    app:cardBackgroundColor="@color/rt_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_goods"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_200"
            android:scaleType="centerCrop"
            android:background="@color/rt_surface_variant"/>

        <TextView
            android:id="@+id/tv_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_10"
            android:background="@drawable/item_goods_bg"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_2"
            android:textColor="@color/rt_text_on_primary"
            android:textSize="@dimen/text_caption"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:layout_marginEnd="@dimen/space_10"
            android:textSize="@dimen/text_body"
            android:textColor="@color/rt_text_primary"
            android:maxLines="2"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_10">

            <!-- 价格区：现价 + （原价划线 + 折扣标签），占满剩余宽度 -->
            <LinearLayout
                android:layout_width="@dimen/space_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 现价：货币符号 + 数值 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥"
                        android:textSize="@dimen/text_label"
                        android:textColor="@color/rt_accent"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_1"
                        android:textColor="@color/rt_accent"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- 原价（划线） + 折扣标签：无优惠时整行隐藏 -->
                <LinearLayout
                    android:id="@+id/ll_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/tv_original_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/rt_text_secondary"/>

                    <TextView
                        android:id="@+id/tv_discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:background="@drawable/bg_discount_tag"
                        android:paddingStart="@dimen/space_4"
                        android:paddingEnd="@dimen/space_4"
                        android:paddingTop="@dimen/space_1"
                        android:paddingBottom="@dimen/space_1"
                        android:textColor="@color/rt_text_on_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_add_to_cart"
                android:layout_width="@dimen/space_24"
                android:layout_height="@dimen/space_24"
                android:layout_marginStart="@dimen/space_6"
                android:layout_marginEnd="@dimen/space_4"
                android:background="@drawable/gouwucheanniu"
                android:backgroundTint="@null"
                android:tintMode="src_atop"
                android:contentDescription="购物车"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
