<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 助手：订单预览卡片
  =====================================================
  标题 "订单预览" + 商品列表（每行 名称 x 数量） + 总价 + 默认地址 + 「确认下单」按钮。
  真实下单由按钮触发：调 POST /api/orders，传入 cartItemIds 和 defaultAddress。
  AI 不会替你付款。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    android:background="@drawable/bg_chat_attachment_card"
    android:orientation="vertical"
    android:padding="@dimen/space_10">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="订单预览"
        android:textColor="@color/chat_text_ai"
        android:textSize="@dimen/chat_text_size_meta"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/ll_chat_order_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_1"
        android:layout_marginTop="@dimen/space_6"
        android:background="@color/chat_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="合计："
            android:textColor="@color/chat_text_ai_muted"
            android:textSize="@dimen/text_label" />

        <TextView
            android:id="@+id/tv_chat_order_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rt_primary"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            tools:text="¥99.90" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_chat_order_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textColor="@color/chat_text_ai_muted"
        android:textSize="@dimen/text_label"
        tools:text="默认收货：上海市浦东新区张江路 1234 号 张三 13800138000" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_chat_order_confirm"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_40"
        android:layout_marginTop="@dimen/space_8"
        android:insetTop="@dimen/space_0"
        android:insetBottom="@dimen/space_0"
        android:minHeight="@dimen/space_0"
        android:backgroundTint="@color/rt_primary"
        android:text="确认下单（不会自动扣款）"
        android:textColor="@color/rt_text_on_primary"
        android:textSize="@dimen/text_label" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="提示：AI 不会自动下单；必须由你点击上方按钮才会创建订单。"
        android:textColor="@color/chat_text_ai_muted"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
