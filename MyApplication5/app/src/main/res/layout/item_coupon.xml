<?xml version="1.0" encoding="utf-8"?>
<!--
  优惠券列表项（item_coupon）
  左：优惠额（¥10 / 9折）+ 使用门槛；右：券名 + 规则 + 有效期；最右：去使用 / 状态文案。
  已使用、已过期的券整项降低透明度（由代码设置 alpha），不给「去使用」入口。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_12"
    android:layout_marginEnd="@dimen/space_12"
    android:layout_marginBottom="@dimen/space_12"
    android:background="@drawable/bg_section_card"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/layout_coupon_amount"
        android:layout_width="@dimen/size_100"
        android:layout_height="match_parent"
        android:background="@drawable/bg_coupon_amount"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_20"
        android:paddingBottom="@dimen/space_20">

        <TextView
            android:id="@+id/tv_coupon_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rt_primary"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold"
            tools:text="¥10" />

        <TextView
            android:id="@+id/tv_coupon_threshold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textColor="@color/rt_text_secondary"
            android:textSize="@dimen/text_caption"
            tools:text="满 ¥100 可用" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/space_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_14"
        android:paddingTop="@dimen/space_14"
        android:paddingEnd="@dimen/space_10"
        android:paddingBottom="@dimen/space_14">

        <TextView
            android:id="@+id/tv_coupon_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rt_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            tools:text="满 100 减 10（全场通用）" />

        <TextView
            android:id="@+id/tv_coupon_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rt_text_secondary"
            android:textSize="@dimen/text_label"
            tools:text="满 ¥100 减 ¥10" />

        <TextView
            android:id="@+id/tv_coupon_expire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rt_text_hint"
            android:textSize="@dimen/text_caption"
            tools:text="有效期至 2026-10-01 23:59" />
    </LinearLayout>

    <!-- 未使用 → 「去使用」；已使用/已过期 → 状态文案（置灰） -->
    <TextView
        android:id="@+id/tv_coupon_action"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:minWidth="@dimen/size_68"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_14"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:text="去使用"
        android:textColor="@color/rt_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />
</LinearLayout>
