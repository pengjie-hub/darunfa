<?xml version="1.0" encoding="utf-8"?>
<!--
  订单卡片「组内单个商品」行。
  一张卡片 = 一个订单；订单里有几件商品就 inflate 几行本布局，由
  MineFunctionActivity.OrderAdapter 动态塞进 item_mine_order.xml 的 ll_goods。
  组内多行时，行与行之间由 item_order_goods_divider.xml 分隔。

  为什么把商品信息从 item_mine_order.xml 拆出来：
  同一订单的多件商品必须共用一个卡片头（订单号 / 状态 chip）与卡片尾（时间 / 操作按钮），
  商品行只能重复出现 —— 只有拆成独立布局才能在组内按数量重复 inflate。

  注意：
  · 本布局的 5 个 id 由 OrderAdapter.bindGoodsRow() 绑定，禁止改名或删除。
  · 不做 maxLines 截断的商品名会撑破卡片，标题固定 2 行；价格固定 1 行。
  · btn_goods_review 只有「待评价」页才可见（其他页整行隐藏，避免占位留白）。
-->
<LinearLayout
    android:foreground="?attr/selectableItemBackground" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/iv_goods_img"
        android:layout_width="@dimen/size_60"
        android:layout_height="@dimen/size_60"
        android:background="@drawable/bg_product_thumb"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/yingtao1"
        android:contentDescription="商品图片" />

    <LinearLayout
        android:layout_width="@dimen/space_0"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_goods_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="@dimen/space_2"
            android:textColor="@color/rt_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:text="商品名称" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:orientation="horizontal"
            android:gravity="bottom">

            <!-- 价格：强调色 + 加粗 + 放大，用户扫视的第一落点 -->
            <TextView
                android:id="@+id/tv_goods_price"
                android:layout_width="@dimen/space_0"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/space_0"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/rt_accent"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:text="¥49.80" />

            <TextView
                android:id="@+id/tv_goods_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:textColor="@color/rt_text_hint"
                android:textSize="@dimen/text_label"
                android:text="x1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 「去评价」下移到商品行：评价是「每人每商品一条」，一单多商品时每件要各自评分，
         放卡片级只能评到其中一件。非待评价页隐藏（GONE 不占位）。 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_goods_review"
        style="@style/RtButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_32"
        android:layout_marginStart="@dimen/space_8"
        android:minWidth="@dimen/space_0"
        android:minHeight="@dimen/space_0"
        android:paddingHorizontal="@dimen/space_14"
        android:text="去评价"
        android:textSize="@dimen/text_label"
        android:visibility="gone"
        app:cornerRadius="@dimen/radius_lg" />
</LinearLayout>
