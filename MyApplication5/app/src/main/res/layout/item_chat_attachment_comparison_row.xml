<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 助手：参数对比 —— 一行（参数名 label + 各商品的值）
  =====================================================
  用一行横向 LinearLayout 装：第一列 label（粗体），后续列值文本。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_0"
    android:paddingEnd="@dimen/space_0">

    <TextView
        android:id="@+id/tv_chat_compare_row_label"
        android:layout_width="@dimen/space_64"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="@dimen/space_4"
        android:textColor="@color/chat_text_ai_muted"
        android:textSize="@dimen/text_label"
        tools:text="当前价" />

    <LinearLayout
        android:id="@+id/ll_chat_compare_row_values"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</LinearLayout>
