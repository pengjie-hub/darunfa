<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.MineFragment"
    android:background="@color/rt_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rt_background"
        android:elevation="@dimen/elevation_flat">

        <!-- 可折叠的顶部区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/rt_background"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <!-- 用户信息头部(渐变背景) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_red_pink"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_24"
                android:paddingBottom="@dimen/space_24"
                android:paddingStart="@dimen/space_20"
                android:paddingEnd="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 头像(圆形) -->
                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="@dimen/size_68"
                        android:layout_height="@dimen/size_68"
                        android:src="@drawable/apple"
                        android:background="@drawable/circle_shape"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:clipToOutline="true"
                        android:outlineProvider="background" />

                    <!-- 用户名 / 会员等级 -->
                    <LinearLayout
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_16"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未登录"
                            android:textColor="@color/rt_text_on_primary"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_member_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:text="金卡会员"
                            android:textColor="@color/rt_text_on_gradient_secondary"
                            android:textSize="@dimen/text_label"
                            android:background="@drawable/bg_member_tag"
                            android:paddingStart="@dimen/space_10"
                            android:paddingEnd="@dimen/space_10"
                            android:paddingTop="@dimen/space_4"
                            android:paddingBottom="@dimen/space_4" />
                    </LinearLayout>

                    <!-- 右侧设置图标 -->
                    <ImageView
                        android:id="@+id/iv_settings"
                        android:layout_width="@dimen/space_32"
                        android:layout_height="@dimen/space_32"
                        android:src="@drawable/baseline_sentiment_satisfied_alt_24"
                        android:tint="@color/rt_text_on_primary"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <!-- 积分 / 余额 / 优惠券 摘要行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:id="@+id/tv_points"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/rt_text_on_primary"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="积分"
                            android:textColor="@color/rt_text_on_gradient_secondary"
                            android:textSize="@dimen/text_label" />
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/space_1"
                        android:layout_height="@dimen/size_btn_sm"
                        android:background="@color/rt_divider_on_primary" />

                    <LinearLayout
                        android:id="@+id/balance_summary"
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:id="@+id/tv_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥0.00"
                            android:textColor="@color/rt_text_on_primary"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="余额"
                        android:textColor="@color/rt_text_on_gradient_secondary"
                        android:textSize="@dimen/text_label" />
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/space_1"
                        android:layout_height="@dimen/size_btn_sm"
                        android:background="@color/rt_divider_on_primary" />

                    <LinearLayout
                        android:id="@+id/coupon_summary"
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:id="@+id/tv_coupons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/rt_text_on_primary"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="优惠券"
                        android:textColor="@color/rt_text_on_gradient_secondary"
                            android:textSize="@dimen/text_label" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 我的订单区块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_section_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_12"
                android:elevation="@dimen/elevation_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="@dimen/space_8">

                    <TextView
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="我的订单"
                        android:textColor="@color/rt_text_primary"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_view_all_orders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="查看全部订单 >"
                        android:textColor="@color/rt_text_secondary"
                        android:textSize="@dimen/text_label"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/space_4" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/mine_grid_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- 默认地址卡：展示当前默认收货地址，点击进入地址管理。
                 结算时收银台会自动带出这条地址，用户不用每次手填手机号和地址。 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_default_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginStart="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                app:cardBackgroundColor="@color/rt_surface"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="@dimen/elevation_sm"
                app:rippleColor="@color/rt_ripple"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_14">

                    <TextView
                        android:layout_width="@dimen/size_btn_sm"
                        android:layout_height="@dimen/size_btn_sm"
                        android:background="@drawable/bg_chat_bubble_ai"
                        android:gravity="center"
                        android:text="址"
                        android:textColor="@color/chat_text_ai_muted"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_12"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="默认收货地址"
                            android:textColor="@color/rt_text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_default_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="还没有地址，点此添加"
                            android:textColor="@color/rt_text_secondary"
                            android:textSize="@dimen/text_label" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/rt_text_hint"
                        android:textSize="@dimen/text_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 功能列表 -->
            <LinearLayout
                android:id="@+id/feature_list_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginStart="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                android:background="@drawable/bg_section_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16"
                android:elevation="@dimen/elevation_sm">

                <ListView
                    android:id="@+id/feature_list_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@null"
                    android:dividerHeight="@dimen/space_0"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- 在线客服入口（原来这里是「小发智能购物助手」，与首页悬浮球重复，
                 已按需求移除；同一个位置改成客服入口，点击进入 AI 客服聊天页）。
                 未登录时由代码拦截并跳转登录页。 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cs_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginStart="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                app:cardBackgroundColor="@color/rt_surface"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="@dimen/elevation_sm"
                app:rippleColor="@color/rt_ripple"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_14">

                    <TextView
                        android:layout_width="@dimen/size_btn_sm"
                        android:layout_height="@dimen/size_btn_sm"
                        android:background="@drawable/bg_chat_bubble_ai"
                        android:gravity="center"
                        android:text="客"
                        android:textColor="@color/chat_text_ai_muted"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="@dimen/space_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_12"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="在线客服"
                            android:textColor="@color/rt_text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_cs_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="AI 智能客服 7×24 在线，可转人工"
                            android:textColor="@color/rt_text_secondary"
                            android:textSize="@dimen/text_label" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/rt_text_hint"
                        android:textSize="@dimen/text_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 退出登录(未登录时由代码隐藏) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginStart="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                android:text="退出登录"
                android:textSize="@dimen/text_body"
                android:textColor="@color/rt_primary"
                android:visibility="gone"
                app:backgroundTint="@color/rt_surface"
                app:cornerRadius="@dimen/radius_md"
                app:strokeColor="@color/rt_primary"
                app:strokeWidth="@dimen/space_1" />

            <!-- 商品推荐 Tab -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/mine_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginStart="@dimen/space_12"
                android:layout_marginEnd="@dimen/space_12"
                android:background="@drawable/bg_section_card"
                android:elevation="@dimen/elevation_sm"
                app:tabIndicatorColor="@color/rt_primary"
                app:tabIndicatorHeight="@dimen/space_4"
                app:tabSelectedTextColor="@color/rt_primary"
                app:tabTextColor="@color/rt_text_secondary"
                android:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mine_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
