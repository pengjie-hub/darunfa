<?xml version="1.0" encoding="utf-8"?>
<!--
  促销活动详情弹框（紧凑版）
  设计目标：在保证内容完整可读的前提下尽量压矮，避免默认 AlertDialog 那种"大标题 + 大留白"的臃肿感。

  高度构成（典型值，约 190dp，比系统默认弹框矮约 1/4）：
    头部色带 40dp + 内容区(标题/时间/描述) + 底部按钮区 54dp
  控高策略：
    · 头部色带压到 40dp，把「类型 + 优惠角标」合并进这一行，省掉独立标题块；
    · 优惠内容不再单独占一行（已在色带里以大号角标呈现）；
    · 描述放进 ScrollView，超长时内部滚动，弹框整体不会被撑高（上限在 PromotionNavigator 里按屏高 55% 计算）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_promo_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_sheet"
    android:orientation="vertical">

    <!-- ===== 头部色带：类型标签 + 优惠角标（背景由代码按满减/折扣设置，含顶部圆角） ===== -->
    <LinearLayout
        android:id="@+id/layout_promo_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_40"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16">

        <TextView
            android:id="@+id/tv_dialog_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_promo_type_tag"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_1"
            android:paddingBottom="@dimen/space_1"
            android:text="满减"
            android:textColor="@color/rt_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dialog_tag"
            android:layout_width="@dimen/space_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="@color/rt_shadow_soft"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="满 ¥100 减 ¥20"
            android:textColor="@color/rt_text_on_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 内容区 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingTop="@dimen/space_12">

        <TextView
            android:id="@+id/tv_dialog_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="@dimen/space_1"
            android:maxLines="2"
            android:text="满 100 减 20（全场通用）"
            android:textColor="@color/rt_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <!-- 活动时间：压成单行（原实现放在多行 message 里，占了额外两行高度） -->
        <TextView
            android:id="@+id/tv_dialog_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="活动时间：2026-09-01 00:00 至 2026-09-30 23:59"
            android:textColor="@color/rt_text_secondary"
            android:textSize="@dimen/text_label" />

        <!-- 描述：超长时内部滚动，弹框整体高度不受影响 -->
        <ScrollView
            android:id="@+id/sv_dialog_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_dialog_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/space_4"
                android:text="单笔消费满 ¥100 元，立减 ¥20 元"
                android:textColor="@color/rt_text_secondary"
                android:textSize="@dimen/text_label" />
        </ScrollView>
    </LinearLayout>

    <!-- ===== 底部操作区：右对齐文字按钮，比默认整条按钮栏更省高度 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_8">

        <!-- 领取优惠券：仅「有满减/折扣规则的券型活动」显示，由代码控制可见性 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_claim"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_40"
            android:layout_marginEnd="@dimen/space_4"
            android:insetTop="@dimen/space_0"
            android:insetBottom="@dimen/space_0"
            android:minWidth="@dimen/size_96"
            android:paddingStart="@dimen/space_14"
            android:paddingEnd="@dimen/space_14"
            android:text="领取优惠券"
            android:textColor="@color/rt_text_on_primary"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            app:backgroundTint="@color/rt_primary"
            app:cornerRadius="@dimen/radius_xl" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_ok"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_40"
            android:insetTop="@dimen/space_0"
            android:insetBottom="@dimen/space_0"
            android:minWidth="@dimen/space_64"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:text="知道了"
            android:textColor="@color/rt_primary"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
</LinearLayout>
