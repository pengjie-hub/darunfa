<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:foreground="?attr/selectableItemBackground" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_14"
    android:layout_marginBottom="@dimen/space_10"
    android:background="@drawable/bg_section_card">

    <!-- 顶部: 用户名 + 评分 + 时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_review_user"
            android:layout_width="@dimen/space_0"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/rt_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:text="用户名" />

        <TextView
            android:id="@+id/tv_review_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rt_warning"
            android:textSize="@dimen/text_label"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/space_12"
            android:text="5.0★" />

        <TextView
            android:id="@+id/tv_review_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rt_text_hint"
            android:textSize="@dimen/text_caption"
            android:text="2026-08-15" />
    </LinearLayout>

    <!-- 评论内容 -->
    <TextView
        android:id="@+id/tv_review_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textColor="@color/rt_text_secondary"
        android:textSize="@dimen/text_label"
        android:lineSpacingExtra="@dimen/space_4"
        android:text="评论内容" />

    <!-- 追评列表容器 -->
    <LinearLayout
        android:id="@+id/ll_replies_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/space_8"
        android:visibility="gone" />

    <!-- 底部操作栏: 追评按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/space_10">

        <TextView
            android:id="@+id/btn_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="追评"
            android:textColor="@color/rt_info"
            android:textSize="@dimen/text_label"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:background="@drawable/bg_search"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
